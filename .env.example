APP_NAME=NOXO
# 应用环境：local/production/testing
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_CHECK_SIGN=true
APP_CHECK_LOGIN=true
APP_CHECK_PAY=true
APP_CHECK_PAY_ORDER=true

APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nox_db
DB_USERNAME=nox_db
DB_PASSWORD=123456

SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 队列连接：sync, database, redis
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API签名密钥，请勿泄露！
SIGN_KEY=
SIGN_TIME_OUT=6

ADMIN_HTTPS=true
ADMIN_ASSETS_SERVER=null
ADMIN_ROUTE_DOMAIN=null
# 管理后台地址前缀，请勿泄露！
ADMIN_ROUTE_PREFIX=admin

#区块链id
ASSET_CHAIN_ID=56

# 收款地址
ASSET_PAY_ADDRESS=

# 支付合约ABI
PAY_ABI_PATH=abi/payment.json
# 支付合约地址
PAY_CONTRACT=

# 提现合约ABI
WITHDRAW_ABI_PATH=abi/withdraw.json
# 提现合约地址
WITHDRAW_CONTRACT=
# 提现出金签名地址
WITHDRAW_ADDRESS=
# 提现出金签名私钥，请勿泄露！
WITHDRAW_KEY=
